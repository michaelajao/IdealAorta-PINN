# ============================================================================
# IdealAorta-PINN
# TRACKED: source (idealaorta_pinn/, scripts/, configs/, tests/), README, and the
#          small slice summary data/results_on_slices.csv.
# IGNORED (below): raw/processed CFD data, trained fields, run logs,
#          auto-generated report artifacts, and the manuscript (paper/) — all
#          regenerated by scripts/prepare.py and scripts/reconstruct.py, or kept
#          out of the code repo entirely.
# ============================================================================

# --- CFD data (large: ~1.1 GB raw + ~0.4 GB processed parquet/npz cache) ---
#     Everything under data/ is ignored (raw exports of every vintage, parquet caches)
#     except the small tracked slice summary. The CFD data belong to the coauthors
#     and must never reach this public repository.
data/*
!data/results_on_slices.csv

# --- Revision workspace: referee reports, plan, coauthor drafts, result JSONs ---
#     Private; kept out of the public repo like paper/. Back it up separately.
revision/

# --- Cluster / queue logs (brosnan, Sulis/Slurm) ---
logs_rev2/
slurm-*.out
slurm-*.err

# --- Trained neural fields: checkpoints and per-run artifacts ---
#     (regenerate with scripts/reconstruct.py; share a specific run out-of-band,
#     not via git.)
models/
*.pt
*.ckpt
*.log

# --- Report deliverables: auto-generated from the trained model, regenerable ---
report/

# --- Manuscript: not part of the public code release ---
paper/

# --- Legacy (nothing should write here anymore) ---
outputs/
experiments/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
CLAUDE.md

# --- off-book local experiments: not part of the reported study ---
*.local.yaml

# --- Scratch: field-map arrays, generator logs, manuscript review drafts ---
#     Written by scripts/manuscript/*; holds paper text, so it stays private.
tmp/
archive/

# --- Local LaTeX (MiKTeX) state ---
.miktex/
