# ============================================================================
# IdealAorta-PINN
# TRACKED: source (idealaorta_pinn/, scripts/, configs/), README, and the small
#          generated case index data/registry.json.
# IGNORED (below): raw/processed CFD data, trained checkpoints, run logs,
#          auto-generated report artifacts, and the manuscript (paper/) — all
#          regenerated by the pipeline (scripts/prepare.py, scripts/run.py) or
#          kept out of the code repo entirely.
# ============================================================================

# --- CFD data (large: ~1.1 GB raw + ~0.4 GB processed parquet/npz cache) ---
data/raw/
data/processed/
!data/registry.json            # small JSON case index — keep under version control

# --- Trained models: checkpoints + per-run training artifacts + run logs ---
#     (loss_history.csv / normalizer.json live under models/<run>/; regenerate
#     with scripts/run.py. Share a specific model out-of-band, not via git.)
models/
*.pt
*.ckpt
*.log

# --- Report deliverables: auto-generated from the trained model, regenerable ---
report/

# --- Manuscript: not part of the public code release ---
paper/

# --- Legacy (nothing should write here anymore) ---
outputs/
experiments/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
CLAUDE.md

# --- off-book local experiments: not part of the reported study ---
*.local.yaml
